# Frontend environment (Vite). Copy to .env.local for local overrides —
# .env.local is gitignored and takes precedence over .env.
#
# IMPORTANT: every VITE_* value is baked into the bundle at BUILD time and is
# publicly visible to anyone who views source. Never put a secret here. On
# Vercel, changing any of these requires an explicit Redeploy — saving the
# variable alone does nothing to the already-built assets.

# Backend API base URL. Local dev: http://localhost:8000
VITE_API_URL=http://localhost:8000

# --- Observability (WS10.6) — all optional; unset = complete no-op ---------
# Without these the SDKs are never even downloaded and nothing is sent.
# Deployment steps: deployment.md §6.5

# PostHog product analytics. Project API key from posthog.com (starts "phc_").
# Public by design — it ships in the browser bundle.
VITE_POSTHOG_KEY=

# Only needed if your PostHog project is NOT on US Cloud.
# EU: https://eu.i.posthog.com — unset defaults to https://us.i.posthog.com
VITE_POSTHOG_HOST=

# Sentry DSN for the FRONTEND (React) project — a different DSN from the
# backend's SENTRY_DSN in the root .env.example. Don't share one between them.
VITE_SENTRY_DSN=
